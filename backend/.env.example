# Local Homebrew PostgreSQL uses the current macOS account by default.
DATABASE_URL=postgresql+psycopg2://localhost:5432/ayo_dev
ENABLE_ADVANCED_SEARCH=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
TRUSTED_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
